{
  "name": "rd-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "lint": "eslint . --fix",
    "preview": "vite preview",
    "test": "NODE_OPTIONS='--max-old-space-size=8192' vitest --run",
    "test-debug": "NODE_OPTIONS='--max-old-space-size=8192 --expose-gc' vitest --run --reporter=verbose",
    "watch": "NODE_OPTIONS='--max-old-space-size=8192 --expose-gc' vitest",
    "coverage": "NODE_OPTIONS='--max-old-space-size=8192 --expose-gc' vitest --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.984.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@hello-pangea/dnd": "^18.0.0-beta.0",
    "@lexical/react": "^0.23.1",
    "@mui/icons-material": "^6.3.0",
    "@mui/material": "^6.3.0",
    "@mui/x-tree-view": "^7.24.1",
    "@stripe/react-stripe-js": "^3.1.1",
    "@stripe/stripe-js": "^5.5.0",
    "axios": "^1.12.0",
    "dompurify": "^3.2.6",
    "lexical": "^0.23.1",
    "oidc-client-ts": "^3.1.0",
    "primereact": "^10.8.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-dropzone": "^14.3.5",
    "react-oidc-context": "^3.2.0",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/stripe-v3": "^3.1.33",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.6.2",
    "prettier-eslint": "^16.4.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.4.1",
    "vitest": "^3.0.5"
  }
}
